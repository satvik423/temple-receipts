MONGODB_URI=mongodb://localhost:27017/temple-receipts

# Session signing secret. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-string

# Bootstrap admin — created on the first request if the users collection is empty.
# Leave these unset to instead run first-time setup from the /login page.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Email delivery (SMTP). Works with Gmail, Outlook, Zoho, or any SMTP server.
# Gmail setup: enable 2FA on the account, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Temple Receipts <noreply@example.com>

# Leave all SMTP_* unset to log OTPs to the server console instead of sending.

# mongoexport --uri=mongodb://localhost:27017/temple-receipts
